@startuml architecture

    !theme vibrant
    skinparam classAttributeIconSize 0
    skinparam classFontSize 12
    skinparam packageFontSize 12

    package "Core Systems" {
        class ResourceManager <<Singleton>> {
            - b2WorldId m_world_id
            - vector<vector<Texture>> texture_resources
            - vector<Shader> shader_resources
            - vector<Model> model_resources
            --
            + {static} instance() : ResourceManager&
            + world_id() : b2WorldId
            + get_texture_resource(TextureResource) : vector<Texture>*
            + get_shader_resource(ShaderResource) : Shader*
            + get_model_resource(ModelResource) : Model*
            - load_texture_resource(int, string_view) : vector<Texture>
            - load_shader_resource(string_view) : Shader
            - ResourceManager()
            - ~ResourceManager()
        }

        class "StateManager<E>" <<template>> {
            - E m_state
            - E m_previous_state
            --
            + StateManager()
            + StateManager(E)
            + state() const : E
            + previous_state() const : E
            + set_state(E) : void
            + is_state(E) const : bool
            + transition(E) : bool
        }

        class Settings {
            + {static} initialise() : void
            + {static} TimestampLogCallback() : void
        }

        class GENERAL {
            + {static} SCREEN_WIDTH : int = 1280
            + {static} SCREEN_HEIGHT : int = 720
            + {static} TARGET_FPS : int = 512
            + {static} TEXELS_PER_UNIT : float = 32.0f
        }

        class PHYSICS {
            + {static} GRAVITY_ACCELERATION : float = -9.81f
            + {static} TIMESTEP : float = 1.0f/60.0f
            + {static} SUBSTEP_COUNT : int = 4
        }

        class ResourceVars {
            --
            FRAMES_AMOUNT::PLAYER::IDLE : int = 6
            FRAMES_AMOUNT::PLAYER::RUN : int = 8
            FRAMES_AMOUNT::PLAYER::SLIDE : int = 5
            --
            TEXTUREPATH::PLAYER::IDLE : string_view
            TEXTUREPATH::PLAYER::RUN : string_view
            TEXTUREPATH::PLAYER::SLIDE : string_view
            --
            SHADERPATH::PLAYER::SHADER : string_view
        }
    }

    package "Game Entities" {
        class Player {
            - StateManager<PlayerState> state
            - b2BodyId m_bodyID
            - vector<b2BodyId> bodyIDs
            - AnimatedModel* m_model
            - vector<AnimatedModel> models
            - const float MAX_MOVE_VELOCITY = 10.0f
            - float move_force = 10.0f
            - float jump_force = 2.5f
            - bool facingleft = false
            - bool receive_input = true
            --
            + Player()
            + ~Player()
            + bodyID() const : b2BodyId
            + model() const : AnimatedModel*
            + set_input(bool) : void
            + handle_input() : void
            + animate() : void
            + draw() : void
            - switch_to_body(b2BodyId) : void
        }

        class AnimatedModel {
            - bool looping
            - Vector2 pivot
            - vector<pair<int, float>> textures_timing
            - int frameindex
            - float timer
            - float duration
            - bool finished
            - vector<Texture>* textures
            - Shader* shader
            - Model* m_model
            - vector<float> timing_cumulative
            --
            + AnimatedModel()
            + AnimatedModel(TextureResource, ShaderResource, ModelResource, bool, Vector2, vector<pair<int, float>>&&)
            + AnimatedModel(TextureResource, ShaderResource, ModelResource, bool, Vector2, float)
            + AnimatedModel(const AnimatedModel&)
            + AnimatedModel(AnimatedModel&&)
            + operator=(const AnimatedModel&)
            + operator=(AnimatedModel&&)
            + ~AnimatedModel()
            + width() const : float
            + height() const : float
            + model() const : Model*
            + animate() : void
            - bsearch_frameindex() : int
            - initialise_timings() : void
        }

        class PlayerCameraController {
            - Camera3D m_camera
            --
            + PlayerCameraController()
            + camera() : Camera3D
            + follow(Transform) : void
            + move_right(float) : void
        }

        enum PlayerState <<enum class>> {
            PLAYER_IDLE
            PLAYER_MOVING
            PLAYER_SLIDE
            PLAYER_JUMPING
        }

        enum TextureResource <<enum class>> {
            PLAYER_IDLE
            PLAYER_RUN
            PLAYER_SLIDE
            COUNT
        }

        enum ShaderResource <<enum class>> {
            PLAYER
            COUNT
        }

        enum ModelResource <<enum class>> {
            PLAYER_IDLE
            PLAYER_RUN
            PLAYER_SLIDE
            COUNT
        }
    }

    package "External Dependencies" {
        class Box2D <<external>> {
            + b2WorldId
            + b2BodyId
            + b2CreateWorld()
            + b2CreateBody()
            + b2World_Step()
            + b2CreatePolygonShape()
            + b2MakeBox()
        }

        class Raylib <<external>> {
            + Model
            + Texture
            + Shader
            + Camera3D
            + Vector2
            + Transform
            + DrawModel()
            + LoadModel()
            + LoadTexture()
            + LoadShader()
            + LoadModelFromMesh()
            + GenMeshCube()
            + UnloadModel()
            + UnloadTexture()
            + UnloadShader()
            + GetFrameTime()
            + BeginDrawing()
            + EndDrawing()
            + BeginMode3D()
            + EndMode3D()
            + DrawGrid()
            + DrawFPS()
            + EnableCursor()
            + DisableCursor()
        }
    }

    package "Main Application" {
        class Main {
            + main(argc, argv) : int
            + DrawGridY(int slices, float spacing) : void
            --
            Game Loop:
            - Cursor toggle handling (ESC key)
            - Physics simulation (fixed timestep with accumulation)
            - Animation updates
            - Input handling
            - 3D rendering with dual grids (XZ and Y planes)
            - FPS display
            - Ground plane with Box2D physics
        }
    }

    ' Relationships
    ResourceManager --> Box2D : manages world
    ResourceManager --> Raylib : loads resources
    ResourceManager --> ResourceVars : uses paths/constants
    Player --> "StateManager<PlayerState>" : has
    Player --> AnimatedModel : contains vector
    Player --> Box2D : physics body
    Player --> PlayerState : uses
    AnimatedModel --> ResourceManager : gets resources from
    AnimatedModel --> TextureResource : uses
    AnimatedModel --> ShaderResource : uses
    AnimatedModel --> ModelResource : uses
    AnimatedModel --> Raylib : renders with
    PlayerCameraController --> Raylib : uses Camera3D
    Main --> Player : creates & updates
    Main --> PlayerCameraController : uses
    Main --> ResourceManager : initializes
    Main --> Settings : calls initialise
    Main --> GENERAL : uses constants
    Main --> PHYSICS : uses constants
    Main --> Box2D : steps physics world
    Main --> Raylib : renders scene
    Settings --> Raylib : configures window/fps

    ' Notes
    note right of ResourceManager : ARCHITECTURE DETAILS:\n- Singleton pattern implementation\n- Manages all game resources (textures, shaders, models)\n- Integrates Box2D physics world\n- Generates models dynamically from mesh cubes\n- Uses resourcevars namespace for paths and constants\n- Loads textures with frame-based naming convention

    note right of AnimatedModel : SOPHISTICATED ANIMATION:\n- Binary search for frame indexing\n- Sophisticated timing system with keyframes\n- Supports looping/non-looping animations\n- Uses timing_cumulative for efficient playback\n- Properly integrates with ResourceManager\n- Multiple constructors for different timing modes

    note bottom of "StateManager<E>" : GENERIC TEMPLATE:\nWorks with any enum type\nCurrently used for PlayerState\nSupports state transitions and history

    note right of Player : PLAYER IMPLEMENTATION:\n- Contains StateManager for state handling\n- Has vector of AnimatedModel objects\n- Physics integration with Box2D\n- Handles input, animation, and rendering\n- Supports multiple physics bodies

    note right of PlayerCameraController : CAMERA SYSTEM:\n- Manages 3D camera for player following\n- Contains follow() method for target tracking\n- Supports camera movement controls

@enduml