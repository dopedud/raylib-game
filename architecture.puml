@startuml architecture

    !theme vibrant
    skinparam classAttributeIconSize 0
    skinparam classFontSize 10
    skinparam packageFontSize 12

    package "Core Systems" {
        class ResourceManager <<Singleton>> {
            - b2WorldId m_world_id
            - vector<vector<Texture>> texture_resources
            - vector<Shader> shader_resources
            - vector<Model> model_resources
            - {static} unique_ptr<ResourceManager> m_instance
            - {static} mutex locker
            --
            + {static} instance() : ResourceManager*
            + {static} destroy() : void
            + world_id() : b2WorldId
            + texture_resource(TextureResource) : vector<Texture>*
            + shader_resource(ShaderResource) : Shader*
            + model_resource(ModelResource) : Model*
            - load_texture_resource(int, string_view) : vector<Texture>
            - load_shader_resource(string_view) : Shader
            - load_shader_resource_fs(string_view) : Shader
            + ResourceManager(PrivateKey)
            + ~ResourceManager()
        }

        class "StateManager<E>" <<template>> {
            - E m_state
            - E m_previous_state
            --
            + StateManager()
            + StateManager(E)
            + state() const : E
            + previous_state() const : E
            + set_state(E) : void
            + is_state(E) const : bool
            + transition(E) : bool
        }

        namespace settings {
            class GENERAL {
                + {static} INITIAL_SCREEN_WIDTH : int = 1280
                + {static} INITIAL_SCREEN_HEIGHT : int = 720
                + {static} INITIAL_ASPECT_RATIO : float
                + {static} TARGET_FPS : int = 512
                + {static} TEXELS_PER_UNIT : float = 32.0f
            }

            class PHYSICS {
                + {static} GRAVITY_ACCELERATION : float = -9.81f
                + {static} TIMESTEP : float = 1.0f/60.0f
                + {static} SUBSTEP_COUNT : int = 4
            }

            class INPUT {
                + {static} TIMESTEP : float = 1.0f/512.0f
            }

            class SettingsFunctions {
                + {static} initialise() : void
                + {static} deinitialise() : void
                + {static} TimestampLogCallback(int, char*, va_list) : void
            }
        }

        namespace resourcevars {
            class FRAMES_AMOUNT {
                + PLAYER::IDLE : int = 6
                + PLAYER::RUN : int = 8
                + PLAYER::SLIDE : int = 5
            }

            class TEXTUREPATH {
                + PLAYER::IDLE : string_view
                + PLAYER::RUN : string_view
                + PLAYER::SLIDE : string_view
            }

            class SHADERPATH {
                + DEFAULT : string_view
                + PLAYER : string_view
            }

            class FONTPATH {
                + CASCADIA_CODE : string_view
                + GOOGLE_SANS_CODE : string_view
            }
        }
    }

    package "Game Entities" {
        class Player {
            - StateManager<PlayerState> state
            - b2BodyId m_bodyID
            - vector<b2BodyId> bodyIDs
            - AnimatedModel* m_model
            - vector<AnimatedModel> models
            - {static} const float MAX_MOVE_VELOCITY = 10.0f
            - float move_force = 1000.0f
            - float jump_force = 10000.0f
            - bool facingleft = false
            - bool receive_input = true
            --
            + Player()
            + ~Player()
            + bodyID() const : b2BodyId
            + model() const : AnimatedModel*
            + set_input(bool) : void
            + handle_input() : void
            + animate() : void
            + draw() : void
            - switch_to_body(b2BodyId) : void
        }

        class AnimatedModel {
            - bool looping
            - Vector2 pivot
            - vector<pair<int, float>> textures_timing
            - int frameindex
            - float timer
            - float duration
            - bool finished
            - vector<Texture>* textures
            - Shader* shader
            - Model* m_model
            - vector<float> timing_cumulative
            --
            + AnimatedModel()
            + AnimatedModel(TextureResource, ShaderResource, ModelResource, bool, Vector2, vector<pair<int, float>>&&)
            + AnimatedModel(TextureResource, ShaderResource, ModelResource, bool, Vector2, float)
            + AnimatedModel(const AnimatedModel&)
            + AnimatedModel(AnimatedModel&&)
            + operator=(const AnimatedModel&)
            + operator=(AnimatedModel&&)
            + ~AnimatedModel()
            + width() const : float
            + height() const : float
            + model() const : Model*
            + animate() : void
            - bsearch_frameindex() : int
            - initialise_timings() : void
        }

        class CameraController {
            --
            + handle_input() : void
            + camera() : Camera3D
        }

        class PlayerCameraController {
            --
            + follow() : void
        }

        enum PlayerState <<enum class>> {
            PLAYER_IDLE
            PLAYER_MOVING
            PLAYER_SLIDE
            PLAYER_JUMPING
        }

        enum TextureResource <<enum class>> {
            PLAYER_IDLE
            PLAYER_RUN
            PLAYER_SLIDE
            COUNT
        }

        enum ShaderResource <<enum class>> {
            DEFAULT
            PLAYER
            COUNT
        }

        enum ModelResource <<enum class>> {
            PLAYER_IDLE
            PLAYER_RUN
            PLAYER_SLIDE
            COUNT
        }
    }

    package "External Dependencies" {
        class Box2D <<external>> {
            + b2WorldId
            + b2BodyId
            + b2DefaultBodyDef()
            + b2CreateWorld()
            + b2CreateBody()
            + b2DestroyBody()
            + b2World_Step()
            + b2CreatePolygonShape()
            + b2DefaultShapeDef()
            + b2MakeBox()
        }

        class Raylib <<external>> {
            + Model, Texture, Shader
            + Camera3D, Vector2, Vector3
            + Image, Color
            + DrawModel(), DrawModelEx()
            + LoadModel(), LoadModelFromMesh()
            + LoadTexture(), LoadTextureFromImage()
            + LoadShader(), LoadShaderFromMemory()
            + GenMeshCube(), GenImageColor()
            + UnloadModel(), UnloadTexture(), UnloadImage()
            + GetFrameTime()
            + BeginDrawing(), EndDrawing()
            + BeginMode3D(), EndMode3D()
            + BeginTextureMode(), EndTextureMode()
            + ClearBackground(), DrawGrid()
            + WindowShouldClose()
            + IsKeyPressed(), IsCursorHidden()
            + EnableCursor(), DisableCursor()
        }

        class ImGui <<external>> {
            + Editor integration
            + Debug UI rendering
        }
    }

    package "Main Application" {
        class Main {
            + main(int argc, char* argv[]) : int
            --
            Initialization:
            - Settings and ResourceManager setup
            - Ground physics body creation
            - Player and Camera instantiation
            --
            Game Loop (fixed timestep):
            - ESC key cursor toggle
            - Physics simulation (60Hz with accumulation)
            - Input polling (512Hz with accumulation)
            - Player animation updates
            - Dual rendering paths (Debug/Release)
            - Ground plane with Box2D physics
            --
            Cleanup:
            - Resource deallocation
            - Physics world cleanup
        }
    }

    package "Debug Editor" <<conditional>> {
        class Editor {
            + {static} instance() : Editor*
            + {static} destroy() : void
            + draw() : void
        }

        class ResourceManagerEditor {
            + {static} instance() : ResourceManagerEditor*
            + game_view() : RenderTexture2D*
        }

        class SettingsEditor {
            + DrawGridY(int, float) : void
        }
    }

    ' Core Relationships
    ResourceManager --> Box2D : manages world
    ResourceManager --> Raylib : loads resources
    ResourceManager ..> resourcevars : uses paths/constants
    Player --> "StateManager<PlayerState>" : contains
    Player --> AnimatedModel : contains vector
    Player --> Box2D : physics bodies
    Player --> PlayerState : uses enum
    AnimatedModel --> ResourceManager : gets resources from
    AnimatedModel --> TextureResource : uses enum
    AnimatedModel --> ShaderResource : uses enum
    AnimatedModel --> ModelResource : uses enum
    AnimatedModel --> Raylib : renders with

    ' Main Application Flow
    Main --> Player : creates & updates
    Main --> CameraController : creates & uses
    Main --> ResourceManager : initializes
    Main --> settings : calls functions
    Main --> Box2D : steps physics world
    Main --> Raylib : renders scene
    settings.SettingsFunctions --> Raylib : configures window/fps

    ' Debug Editor (conditional)
    Main --> Editor : creates when DEBUG
    Editor --> ImGui : uses for UI
    ResourceManagerEditor --> Raylib : manages game view texture

    ' Camera Inheritance
    PlayerCameraController --|> CameraController : extends

    ' Notes with Current Issues
    note right of ResourceManager 
        SINGLETON RESOURCE MANAGER:
        - Thread-safe singleton with mutex
        - Manages Box2D physics world
        - Loads textures from numbered sequences
        - Generates quad models for 2D sprites
        - Uses PrivateKey pattern for controlled access
    end note

    note right of AnimatedModel 
        SOPHISTICATED 2D-ON-3D ANIMATION:
        - Binary search for efficient frame lookup
        - Keyframe timing with cumulative arrays
        - Supports complex timing sequences
        - Renders 2D sprite sheets on 3D quads
        - Multiple constructor overloads
    end note

    note bottom of "StateManager<E>" 
        GENERIC STATE MANAGEMENT:
        Template works with any enum type
        Tracks current and previous states
        **ISSUE: Player never transitions states**
    end note

    note right of Player 
        PLAYER ENTITY SYSTEM:
        - Contains multiple AnimatedModel objects
        - Has multiple Box2D bodies (unused)
        - **ISSUES:**
        - State never changes from IDLE
        - handle_input() commented out
        - switch_to_body() never called
        - MOVING/JUMPING animations empty
    end note

    note right of PlayerCameraController 
        CAMERA FOLLOWING SYSTEM:
        **CRITICAL ISSUE:**
        follow() method is completely empty
        Camera moves at fixed speed instead
        No actual player tracking implemented
    end note

    note top of Main 
        FIXED TIMESTEP GAME LOOP:
        - Physics: 60Hz with accumulation
        - Input: 512Hz with accumulation
        - Rendering: Up to 512 FPS
        - Dual debug/release render paths
    end note

@enduml